<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- Plugin assembly + root namespace stay plain "LuaRenamer" (overrides the LuaRenamer.* default in Directory.Build.props). -->
        <RootNamespace>LuaRenamer</RootNamespace>
        <AssemblyName>LuaRenamer</AssemblyName>
        <DisableImplicitNuGetFallbackFolder Condition="'$(CI)' == 'true'">true</DisableImplicitNuGetFallbackFolder>
        <!--<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>-->
        <Authors>Mik1ll</Authors>
        <RepositoryUrl>https://github.com/Mik1ll/LuaRenamer</RepositoryUrl>
        <Nullable>enable</Nullable>
        <!--<DisableFastUpToDateCheck>True</DisableFastUpToDateCheck>-->
        <Deterministic>true</Deterministic>
        <DeterministicSourcePaths>true</DeterministicSourcePaths>
        <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
    </PropertyGroup>

    <!-- The plugin's identity, stamped into the assembly by Shoko.BuildTools.Targets, which also generates the Plugin class from it. -->
    <PropertyGroup Label="Plugin">
        <PluginGenerateClass>true</PluginGenerateClass>
        <PluginID>0c1d69de-a937-59d3-835a-1a0db6aacafc</PluginID>
        <PluginName>LuaRenamer</PluginName>
        <PluginOverview>Lua scripting environment for renaming and moving video files. Provides a powerful Lua 5.4 interface for custom file organization.</PluginOverview>
        <PluginTags>relocation-provider,lua,scripting</PluginTags>
        <PluginThumbnail>../banner16x9.svg</PluginThumbnail>
        <PluginIcon>../icon1x1.svg</PluginIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="KeraLua" Version="1.4.11" />
        <!-- A version range, not a pin: the host supplies ILogger by DI and the plugin API does not itself
             constrain the version, so a major bump must fail at restore (naming the package and the range)
             rather than at runtime. Dependabot still moves the floor within 10.x. -->
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.0.14, 11.0.0)" ExcludeAssets="runtime" />
        <PackageReference Include="NLua" Version="1.7.9" />
        <PackageReference Include="Shoko.Abstractions" Version="6.0.0-alpha.130" ExcludeAssets="runtime" />
        <PackageReference Include="Shoko.BuildTools.Targets" Version="0.7.2" PrivateAssets="All" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\LuaEnv\LuaEnv.csproj" />
        <!-- Build ordering only: ensures DefsGenerator is built before the generation targets below run it.
             The generator is a build-time tool, so it stays RID-agnostic under `publish -r`: it declares no
             RuntimeIdentifiers and a RID-specific restore of it was never done. ResolveDefsGenerator below
             must drop the same properties, or GetTargetPath reports a RID path this build never produced. -->
        <ProjectReference Include="..\DefsGenerator\DefsGenerator.csproj" ReferenceOutputAssembly="false" Private="false" ExcludeAssets="true" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    </ItemGroup>

    <ItemGroup>
        <None Include="lua/**/*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <!-- The *Names navigation DSL, written by GenerateLuaNames below before csc runs. Never checked in,
             so it cannot go stale against LuaEnv's models. -->
        <Compile Include="$(IntermediateOutputPath)LuaNames.g.cs" />
        <FileWrites Include="$(IntermediateOutputPath)LuaNames.g.cs" />
    </ItemGroup>

    <!-- GetTargetPath only computes the path; ResolveProjectReferences has already built the generator. -->
    <Target Name="ResolveDefsGenerator" DependsOnTargets="ResolveProjectReferences">
        <MSBuild Projects="..\DefsGenerator\DefsGenerator.csproj" Targets="GetTargetPath" RemoveProperties="RuntimeIdentifier;SelfContained">
            <Output TaskParameter="TargetOutputs" PropertyName="DefsGenerator" />
        </MSBuild>
    </Target>

    <Target Name="GenerateLuaNames" BeforeTargets="CoreCompile" DependsOnTargets="ResolveDefsGenerator">
        <Exec Command="dotnet &quot;$(DefsGenerator)&quot; --names &quot;$(IntermediateOutputPath)LuaNames.g.cs&quot;" />
    </Target>

    <Target Name="GenerateLuaDefs" AfterTargets="Build" DependsOnTargets="ResolveDefsGenerator">
        <Exec Command="dotnet &quot;$(DefsGenerator)&quot; &quot;$(MSBuildThisFileDirectory)lua/&quot;" />
    </Target>

</Project>
