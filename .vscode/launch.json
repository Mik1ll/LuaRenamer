{
    "version": "0.2.0",
    "configurations": [
        {
            // Plugin has no entry point — attach to the running Shoko host
            // process that has loaded LuaRenamer.dll, then step into NLua etc.
            "name": ".NET Attach (Shoko host)",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "justMyCode": false,
            "suppressJITOptimizations": true,
            "enableStepFiltering": false,
            "requireExactSource": false,
            "sourceFileMap": {
                "/_/": "${workspaceFolder}"
                // NLua & KeraLua both resolve via SourceLink now (NLua's was patched in;
                // see Directory.Build.props / scripts/patch-sourcelink.cs). No build-root
                // map needed — and a "D:\\a\\1\\s" entry would hijack both packages' shared path.
            }
        }
    ]
}
